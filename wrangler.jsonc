{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moe-rna-nn-calculator",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "build": {
    "command": "node --test tests/auth.test.mjs && node scripts/build-static.mjs"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
